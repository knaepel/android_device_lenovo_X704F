# Wi-Fi only tablet
ro.radio.noril=yes
ro.carrier=wifi-only

# Bluetooth: the WCN36xx controller does not know the Qualcomm LE vendor
# commands (LE_ADV_FILTER), the stack aborted on every start
bluetooth.core.le.vendor_capabilities.enabled=false

# Graphics: these Adreno blobs (2019) belong to the older display HAL; the
# CAF gralloc would size GPU buffers through adreno_init_memory_layout.
# Use the classic size calculation like onclite.
vendor.gralloc.disable_ahardware_buffer=1

# Graphics: no UBWC, the old Adreno driver and the CAF gralloc disagree on
# the UBWC buffer size and the GPU wrote past the end of render targets
vendor.gralloc.disable_ubwc=1

# Display: the panel scans in portrait, the tablet is a landscape device
# (Lenovo stock: ro.sf.hwrotation=90). Touch follows in idc/goodix-ts.idc.
ro.surface_flinger.primary_display_orientation=ORIENTATION_90
