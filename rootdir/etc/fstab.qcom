# Lenovo TAB4 10 Plus (TB-X704F)
# <src>                                              <mnt_point>            <type>  <mnt_flags and options>                                                                  <fs_mgr_flags>
/dev/block/by-name/boot                   /boot                  emmc    defaults                                                                                 defaults
/dev/block/by-name/recovery               /recovery              emmc    defaults                                                                                 defaults
/dev/block/by-name/system                 /system                ext4    ro,barrier=1                                                                             wait,first_stage_mount
# lenovocust is unused on this device; it holds the encryption metadata
/dev/block/by-name/lenovocust             /metadata              ext4    nosuid,nodev,noatime,discard,data=journal,commit=1                                       wait,check,formattable,first_stage_mount
/dev/block/by-name/userdata               /data                  ext4    nosuid,nodev,noatime,noauto_da_alloc                                                     wait,check,quota,formattable,reservedsize=128M
/dev/block/by-name/cache                  /cache                 ext4    nosuid,nodev,noatime                                                                     wait,check,formattable
/dev/block/by-name/persist                /mnt/vendor/persist    ext4    nosuid,nodev,barrier=1,no_sehash_xattr                                                   wait
/dev/block/by-name/dsp                    /vendor/dsp            ext4    ro,nosuid,nodev,barrier=1,context=u:object_r:adsprpcd_file:s0                            wait
/dev/block/by-name/modem                  /vendor/firmware_mnt   vfat    ro,shortname=lower,uid=0,gid=1000,dmask=227,fmask=337,context=u:object_r:firmware_file:s0 wait
/dev/block/by-name/misc                   /misc                  emmc    defaults                                                                                 defaults
/dev/block/by-name/config                 /frp                   emmc    defaults                                                                                 defaults
/devices/platform/soc/7864900.sdhci/mmc_host*        auto                   auto    defaults                                                                                 wait,voldmanaged=sdcard1:auto,noemulatedsd
/devices/platform/soc/*.ssusb/*.dwc3/xhci-hcd.*.auto* auto                  auto    defaults                                                                                 voldmanaged=usb:auto
